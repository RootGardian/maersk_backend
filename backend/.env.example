PORT=5000

# Informations d'identification de la base de données (utilisées par le conteneur db)
POSTGRES_USER="maersk_user"
POSTGRES_PASSWORD="maersk_password"
POSTGRES_DB="maersk_db"

# URL de la base de données (utilise le nom du conteneur 'db' au lieu de localhost)
DATABASE_URL="postgresql://maersk_user:maersk_password@db:5432/maersk_db"

# Clés de sécurité (à modifier pour la production)
PEPPER="votre_pepper_secret_ici"
JWT_SECRET="votre_jwt_secret_ici"

# Identifiants de l'administrateur par défaut
ADMIN_EMAIL="admin@exemple.com"
ADMIN_PASSWORD="MotDePasseSecurise123!"
