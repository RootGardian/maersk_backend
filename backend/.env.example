PORT=5000

# URL de la base de données (exemple pour un environnement de développement local)
DATABASE_URL="postgresql://user:password@localhost:5432/maersk_db"

# Clés de sécurité (à générer aléatoirement pour la production)
PEPPER="votre_pepper_secret_ici"
JWT_SECRET="votre_jwt_secret_ici"

# Identifiants de l'administrateur par défaut
ADMIN_EMAIL="admin@exemple.com"
ADMIN_PASSWORD="MotDePasseSecurise123!"
